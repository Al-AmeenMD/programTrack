# ==============================================================================
# ProgramTrack — Environment Configuration Template (.env.example)
# ==============================================================================
# IMPORTANT DEV/PROD SEPARATION GUARD:
# - Local development MUST use a dedicated LOCAL/DEV Supabase project database.
# - NEVER point local `.env` variables at the live production database.
# - Production environment variables are managed separately in Vercel.
# ==============================================================================

# 1. DATABASE_URL: Pooled Connection String for Prisma queries
# For Supabase: Transaction pooler connection string (Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR_DEV_PROJECT_REF]:[YOUR_DEV_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct Connection String for Prisma migrations & schema changes
# For Supabase: Direct session connection string (Port 5432)
DIRECT_URL="postgresql://postgres:[YOUR_DEV_PASSWORD]@db.[YOUR_DEV_PROJECT_REF].supabase.co:5432/postgres"

# 3. JWT_SECRET: Secret key for signing session tokens
# Use a random 32+ character string in production
JWT_SECRET="programtrack-development-jwt-secret-key-change-in-production"
